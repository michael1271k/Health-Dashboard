# ====================================================
# HELIX — Environment Variables
# Copy to .env.local and fill in your values
# ====================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auto-login — the auth screen is ONE button ("Continue as Michael") and these
# are the credentials it signs in with. There is no manual email/password form
# and no password-recovery flow, so if the Supabase password is rotated,
# NEXT_PUBLIC_DEV_PASSWORD must be updated here AND in the Netlify environment,
# then redeployed — otherwise the button returns "invalid login credentials".
# NEXT_PUBLIC_BYPASS_EMAIL / NEXT_PUBLIC_BYPASS_PASSWORD are read as a legacy
# fallback; prefer these names. Leave blank in any shared build (the password
# ships in the client bundle).
