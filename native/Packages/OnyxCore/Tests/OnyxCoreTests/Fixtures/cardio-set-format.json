{
  "module": "utils/setFormat",
  "fn": "formatCardioSet",
  "note": "`5:00 · 0.37 km · 2%`, each component dropped when absent, non-finite or zero — except incline, which keeps a negative (a decline is a real setting). Duration rounds to the nearest SECOND then splits. Null when nothing survives, which is what hands the row back to formatSet.",
  "cases": [
    {
      "name": "300 s / 0.37 km / 2%",
      "input": {
        "durationSec": 300,
        "distanceKm": 0.37,
        "incline": 2
      },
      "expected": "5:00 · 0.37 km · 2%"
    },
    {
      "name": "300 s / null km / null%",
      "input": {
        "durationSec": 300,
        "distanceKm": null,
        "incline": null
      },
      "expected": "5:00"
    },
    {
      "name": "null s / 0.37 km / null%",
      "input": {
        "durationSec": null,
        "distanceKm": 0.37,
        "incline": null
      },
      "expected": "0.37 km"
    },
    {
      "name": "null s / null km / 2%",
      "input": {
        "durationSec": null,
        "distanceKm": null,
        "incline": 2
      },
      "expected": "2%"
    },
    {
      "name": "null s / null km / null%",
      "input": {
        "durationSec": null,
        "distanceKm": null,
        "incline": null
      },
      "expected": null
    },
    {
      "name": "0 s / 0 km / 0%",
      "input": {
        "durationSec": 0,
        "distanceKm": 0,
        "incline": 0
      },
      "expected": null
    },
    {
      "name": "45 s / null km / null%",
      "input": {
        "durationSec": 45,
        "distanceKm": null,
        "incline": null
      },
      "expected": "0:45"
    },
    {
      "name": "3600 s / 10 km / 12.5%",
      "input": {
        "durationSec": 3600,
        "distanceKm": 10,
        "incline": 12.5
      },
      "expected": "60:00 · 10 km · 12.5%"
    },
    {
      "name": "59 s / 1.5 km / -3%",
      "input": {
        "durationSec": 59,
        "distanceKm": 1.5,
        "incline": -3
      },
      "expected": "0:59 · 1.5 km · -3%"
    },
    {
      "name": "61 s / 0.005 km / 0.5%",
      "input": {
        "durationSec": 61,
        "distanceKm": 0.005,
        "incline": 0.5
      },
      "expected": "1:01 · 0.005 km · 0.5%"
    },
    {
      "name": "90.6 s / 2 km / 1%",
      "input": {
        "durationSec": 90.6,
        "distanceKm": 2,
        "incline": 1
      },
      "expected": "1:31 · 2 km · 1%"
    },
    {
      "name": "0 s / 0.37 km / 0%",
      "input": {
        "durationSec": 0,
        "distanceKm": 0.37,
        "incline": 0
      },
      "expected": "0.37 km"
    },
    {
      "name": "125 s / null km / 15%",
      "input": {
        "durationSec": 125,
        "distanceKm": null,
        "incline": 15
      },
      "expected": "2:05 · 15%"
    }
  ]
}
