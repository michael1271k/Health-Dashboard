      "name": "empty",
      "input": {
        "sets": [],
        "exerciseName": "Leg Press"
      },
      "expected": [
        "—"
      ]
    },
    {
      "name": "the rich Leg Press",
      "input": {
        "sets": [
          {
            "weightKg": 40,
            "reps": 15,
            "rpe": null,
            "side": null,
            "failure": false,
            "pairId": null,
            "warmup": true
          },
          {
            "weightKg": 75,
            "reps": 12,
            "rpe": 8.5,
            "side": null,
            "failure": false,
            "pairId": null
          },
          {
            "weightKg": 75,
            "reps": 12,
            "rpe": 9.5,
            "side": null,
            "failure": false,
            "pairId": null,
            "quality": "momentum"
          },
          {
            "weightKg": 75,
            "reps": 10,
            "rpe": 10,
            "side": null,
            "failure": true,
            "pairId": null
          }
        ],
        "exerciseName": "Leg Press"
      },
      "expected": [
