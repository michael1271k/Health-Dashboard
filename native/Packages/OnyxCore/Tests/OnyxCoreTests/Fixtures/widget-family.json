{
  "module": "training/landmarks",
  "fn": "MuscleCredit.weightedSets(exerciseNames:)",
  "note": "THE one accumulator (F7), at the landmark grain. One entry per physical set; resolveMovers by NAME. Secondary at 0.5 first, primary at 1.0 second, `max` on overlap \u2014 so a muscle named in both lists is paid ONCE, in full. Warm-ups count; a ghost set is the caller's to drop and counts for nothing. Tonnage is not part of the currency: `kg` left this fixture with `WidgetDerive.volumeByFamily` in W3. `families` is the eight-family rollup `OnyxSnapshot.volumeByFamily` computes \u2014 a plain sum, so one leg press is 2.0 weighted sets of Legs.",
  "cases": [
    {
      "name": "empty",
      "input": {
        "sets": []
      },
      "expected": {
        "landmarks": {},
        "families": {}
      }
    },
    {
      "name": "a leg press: quads in full, glutes and hamstrings at a half",
      "input": {
        "sets": [
          {
            "exercise": "Leg Press",
            "day": "2026-08-05",
            "weightKg": 200,
            "reps": 8
          }
        ]
      },
      "expected": {
        "landmarks": {
          "Quads": 1.0,
          "Hamstrings": 0.5,
          "Glutes": 0.5
        },
        "families": {
          "Legs": 2.0
        }
      }
    },
    {
      "name": "a lat pulldown credits three arm muscles separately, not one 'Arms'",
      "input": {
        "sets": [
          {
            "exercise": "Lat Pulldown",
            "day": "2026-08-04",
            "weightKg": 70,
            "reps": 10
          }
        ]
      },
      "expected": {
        "landmarks": {
          "Lats": 1.0,
          "Upper back": 0.5,
          "Biceps": 0.5,
          "Forearms": 0.5
        },
        "families": {
          "Back": 1.5,
          "Biceps": 0.5,
          "Forearms": 0.5
        }
      }
    },
    {
      "name": "an unloaded set still counts a set",
      "input": {
        "sets": [
          {
            "exercise": "Hanging Knee Raise",
            "day": "2026-08-04",
            "weightKg": 0,
            "reps": 15
          }
        ]
      },
      "expected": {
        "landmarks": {
          "Abs/core": 1.0
        },
        "families": {
          "Core": 1.0
        }
      }
    },
    {
      "name": "a warm-up counts",
      "input": {
        "sets": [
          {
            "exercise": "Chest Press",
            "day": "2026-08-05",
            "weightKg": 40,
            "reps": 12,
            "setType": "warmup"
          }
        ]
      },
      "expected": {
        "landmarks": {
          "Chest": 1.0,
          "Front delts": 0.5,
          "Triceps": 0.5
        },
        "families": {
          "Chest": 1.0,
          "Shoulders": 0.5,
          "Triceps": 0.5
        }
      }
    },
    {
      "name": "a ghost set counts for nothing",
      "input": {
        "sets": [
          {
            "exercise": "Chest Press",
            "day": "2026-08-05",
            "weightKg": 40,
            "reps": 12,
            "setType": "ghost"
          }
        ]
      },
      "expected": {
        "landmarks": {},
        "families": {}
      }
    },
    {
      "name": "an unknown lift contributes nothing",
      "input": {
        "sets": [
          {
            "exercise": "Mystery Machine",
            "day": "2026-08-05",
            "weightKg": 40,
            "reps": 12
          }
        ]
      },
      "expected": {
        "landmarks": {},
        "families": {}
      }
    },
    {
      "name": "tonnage is not credit: a heavy set and a light set are one set each",
      "input": {
        "sets": [
          {
            "exercise": "Pec Deck",
            "day": "2026-08-05",
            "weightKg": 100,
            "reps": 10
          },
          {
            "exercise": "Pec Deck",
            "day": "2026-08-05",
            "weightKg": 0,
            "reps": 10
          }
        ]
      },
      "expected": {
        "landmarks": {
          "Chest": 2.0
        },
        "families": {
          "Chest": 2.0
        }
      }
    },
    {
      "name": "a row names Upper back twice and is paid once",
      "input": {
        "sets": [
          {
            "exercise": "Seated Cable Row (Wide Grip)",
            "day": "2026-08-02",
            "weightKg": 55,
            "reps": 12
          }
        ]
      },
      "expected": {
        "landmarks": {
          "Lats": 0.5,
          "Upper back": 1.0,
          "Biceps": 0.5,
          "Forearms": 0.5
        },
        "families": {
          "Back": 1.5,
          "Biceps": 0.5,
          "Forearms": 0.5
        }
      }
    },
    {
      "name": "the three delt heads are three muscles: a lateral raise credits only the side",
      "input": {
        "sets": [
          {
            "exercise": "Lateral Raise",
            "day": "2026-08-02",
            "weightKg": 10,
            "reps": 15
          },
          {
            "exercise": "Shoulder Press",
            "day": "2026-08-02",
            "weightKg": 16,
            "reps": 10
          },
          {
            "exercise": "Face Pull",
            "day": "2026-08-02",
            "weightKg": 20,
            "reps": 15
          }
        ]
      },
      "expected": {
        "landmarks": {
          "Front delts": 1.0,
          "Side delts": 1.0,
          "Rear delts": 1.0,
          "Biceps": 0.5,
          "Triceps": 0.5
        },
        "families": {
          "Shoulders": 3.0,
          "Biceps": 0.5,
          "Triceps": 0.5
        }
      }
    },
    {
      "name": "biceps and triceps are separate families, not one Arms",
      "input": {
        "sets": [
          {
            "exercise": "Preacher Curl",
            "day": "2026-08-03",
            "weightKg": 20,
            "reps": 10
          },
          {
            "exercise": "Triceps Pushdown",
            "day": "2026-08-03",
            "weightKg": 30,
            "reps": 12
          }
        ]
      },
      "expected": {
        "landmarks": {
          "Biceps": 1.0,
          "Triceps": 1.0
        },
        "families": {
          "Biceps": 1.0,
          "Triceps": 1.0
        }
      }
    },
    {
      "name": "a full Upper A",
      "input": {
        "sets": [
          {
            "exercise": "Chest Press",
            "day": "2026-08-02",
            "weightKg": 60,
            "reps": 10
          },
          {
            "exercise": "Chest Press",
            "day": "2026-08-02",
            "weightKg": 60,
            "reps": 9
          },
          {
            "exercise": "Lat Pulldown (Neutral Grip)",
            "day": "2026-08-02",
            "weightKg": 70,
            "reps": 10
          },
          {
            "exercise": "Seated Cable Row (Wide Grip)",
            "day": "2026-08-02",
            "weightKg": 55,
            "reps": 12
          },
          {
            "exercise": "Pec Deck",
            "day": "2026-08-02",
            "weightKg": 50,
            "reps": 12
          },
          {
            "exercise": "Face Pull",
            "day": "2026-08-02",
            "weightKg": 20,
            "reps": 15
          },
          {
            "exercise": "Romanian Deadlift",
            "day": "2026-08-02",
            "weightKg": 24,
            "reps": 10
          },
          {
            "exercise": "Shoulder Press",
            "day": "2026-08-02",
            "weightKg": 16,
            "reps": 10
          }
        ]
      },
      "expected": {
        "landmarks": {
          "Chest": 3.0,
          "Lats": 2.0,
          "Upper back": 2.0,
          "Lower back": 0.5,
          "Front delts": 2.0,
          "Rear delts": 1.0,
          "Biceps": 1.5,
          "Triceps": 1.5,
          "Forearms": 1.5,
          "Hamstrings": 1.0,
          "Glutes": 0.5
        },
        "families": {
          "Chest": 3.0,
          "Back": 4.5,
          "Shoulders": 3.0,
          "Biceps": 1.5,
          "Triceps": 1.5,
          "Forearms": 1.5,
          "Legs": 1.5
        }
      }
    },
    {
      "name": "null weight and reps still credit the muscle",
      "input": {
        "sets": [
          {
            "exercise": "Leg Press",
            "day": "2026-08-05",
            "weightKg": null,
            "reps": null
          }
        ]
      },
      "expected": {
        "landmarks": {
          "Quads": 1.0,
          "Hamstrings": 0.5,
          "Glutes": 0.5
        },
        "families": {
          "Legs": 2.0
        }
      }
    }
  ]
}
