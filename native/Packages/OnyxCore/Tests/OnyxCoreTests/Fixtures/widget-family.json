    {
      "name": "empty",
      "input": {
        "sets": []
      },
      "expected": []
    },
    {
      "name": "a leg press credits Legs once in full",
      "input": {
        "sets": [
          {
            "exercise": "Leg Press",
            "day": "2026-08-05",
            "weightKg": 200,
            "reps": 8
          }
        ]
      },
      "expected": [
        {
          "family": "Legs",
          "kg": 1600,
          "sets": 1
        }
      ]
    },
    {
      "name": "a lat pulldown — Back primary, Arms half",
      "input": {
        "sets": [
          {
            "exercise": "Lat Pulldown",
            "day": "2026-08-04",
            "weightKg": 70,
            "reps": 10
          }
        ]
