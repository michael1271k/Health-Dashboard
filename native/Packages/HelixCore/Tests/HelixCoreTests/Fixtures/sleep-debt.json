      },
      "expected": {
        "debtHours": 7.7,
        "nights": 3,
        "worstNightMin": 200,
        "goalHours": 8
      }
    },
    {
      "name": "a full 14-night window",
      "input": {
        "nights": [
          {
            "date": "2026-08-20",
            "sleepMinutes": 300
          },
          {
            "date": "2026-08-21",
            "sleepMinutes": 420
          },
          {
            "date": "2026-08-22",
            "sleepMinutes": 480
          },
          {
            "date": "2026-08-23",
            "sleepMinutes": 540
          },
          {
            "date": "2026-08-24",
            "sleepMinutes": 360
          },
          {
            "date": "2026-08-25",
            "sleepMinutes": 600
          },
          {
            "date": "2026-08-26",
            "sleepMinutes": 450
          },
          {
            "date": "2026-08-27",
            "sleepMinutes": 300
          },
          {
            "date": "2026-08-28",
