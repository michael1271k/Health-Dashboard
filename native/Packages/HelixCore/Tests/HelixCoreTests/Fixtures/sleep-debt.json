      "input": {
        "nights": [
          {
            "date": "2026-09-01",
            "sleepMinutes": 420
          },
          {
            "date": "2026-09-01",
            "sleepMinutes": 600
          }
        ],
        "goalHours": 8,
        "weekAgo": "2026-08-27"
      },
      "expected": {
        "debtHours": 0,
        "nights": 2,
        "worstNightMin": 420,
        "goalHours": 8
      }
