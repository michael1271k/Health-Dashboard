    {
      "name": "parse: well-formed",
      "input": {
        "raw": {
          "arms": 3,
          "legs_a": 2
        },
        "rawEntries": [
          [
            "arms",
            3
          ],
          [
            "legs_a",
            2
          ]
        ],
        "move": null
      },
      "expected": {
        "layout": [
          [
            "arms",
            3
          ],
          [
            "legs_a",
            2
          ]
        ],
        "full": [
          [
            "cb_a",
            0
          ],
          [
            "legs_a",
            2
          ],
          [
            "arms",
            3
          ],
          [
            "cb_b",
            4
          ],
          [
            "legs_b",
            5
          ]
        ],
        "byWeekday": [
          "cb_a",
          null,
          "legs_a",
          "arms",
          "cb_b",
          "legs_b",
          null
        ],
        "effective": [
          0,
          2,
          3,
          4,
          5
        ],
        "authored": false,
        "canonical": "[[\"arms\",3],[\"legs_a\",2]]",
        "moved": null
      }
    },
